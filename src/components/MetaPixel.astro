---
import { getEntry } from 'astro:content';

const artist = await getEntry('artist', 'artist');
const pixelId = artist?.data.metaPixelId;
---

{pixelId && (
  <>
    <script is:inline define:vars={{ pixelId }}>
      /* eslint-disable no-undef, @typescript-eslint/no-unused-expressions */
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      var extId;
      try {
        extId = localStorage.getItem('ext_id');
        if (!extId) {
          extId = (window.crypto && typeof crypto.randomUUID === 'function')
            ? crypto.randomUUID()
            : ('x' + Date.now().toString(36) + Math.random().toString(36).slice(2));
          extId = extId.toLowerCase();
          localStorage.setItem('ext_id', extId);
        }
      } catch (e) { extId = undefined; }
      if (extId) { fbq('init', pixelId, { external_id: extId }); }
      else { fbq('init', pixelId); }
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
           src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`} />
    </noscript>
  </>
)}
